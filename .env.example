# Database Configuration
# Replace with your actual PostgreSQL connection# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pichaus?schema=public"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pichaus?schema=public"

# Application
NODE_ENV="development"
AUTH_SECRET="replace-with-a-random-32+-char-secret"

# Storage Configuration
STORAGE_DRIVER="local"
STORAGE_DIR="storage/uploads"
ASSET_DELIVERY="proxy"
MAX_FILE_SIZE_MB="10"
# Maximum raw body size accepted for each resumable-upload chunk
RESUMABLE_CHUNK_SIZE_MB="3"
# Trust X-Forwarded-For for rate limiting only when behind a trusted reverse proxy
TRUST_PROXY="false"

# S3-compatible storage (set STORAGE_DRIVER="s3" to enable)
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT="" # Optional, for MinIO/R2/etc. Example: https://s3.example.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_SESSION_TOKEN="" # Optional
# S3_PREFIX="" # Optional key prefix inside the bucket
# S3_FORCE_PATH_STYLE="true" # Optional; defaults true for custom endpoints and false for AWS S3
# S3_PUBLIC_BASE_URL="" # Optional CDN/public bucket base URL used when ASSET_DELIVERY="redirect"
# S3_PRESIGNED_URL_TTL_SECONDS="300" # Used for private-bucket redirects when no public base URL is set

# Auto-compression settings (Optional)
# AUTO_COMPRESS_LIMIT_MB="15"      # File size (MB) above which any image is compressed (default: 15)
# FRESH_COMPRESS_LIMIT_MB="4"       # File size (MB) above which fresh-off-camera images are compressed (default: 4)
# AUTO_COMPRESS_FORCE="false"       # Force compression on all images, ignoring editing software bypass (default: false)
# AUTO_COMPRESS_RATIO_MB_PER_MP="0.5" # File size (MB) per Megapixel ratio above which JPEGs are compressed (default: 0.5)
# AUTO_COMPRESS_MAX_DIMENSION="4000" # Max width/height to resize compressed images to (default: 4000)
# AUTO_COMPRESS_QUALITY="88"        # Compression quality from 1-100 (default: 88)

# Job queue settings (Optional)
# QUEUE_CONCURRENCY_METADATA="2"       # Max concurrent metadata jobs (default: 2)
# QUEUE_CONCURRENCY_THUMBNAIL="2"      # Max concurrent thumbnail jobs (default: 2)
# QUEUE_CONCURRENCY_FACE_DETECTION="1" # Max concurrent face-detection jobs (default: 1)
# FACE_DETECTION_ENABLED="false"       # Enqueue face-detection jobs after thumbnails (default: false)

# WebAuthn / Passkeys
# WEBAUTHN_RP_ID must match the domain users visit (no port, no protocol)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="PicHaus"
# WEBAUTHN_ORIGIN must match the exact origin in the browser address bar
WEBAUTHN_ORIGIN="http://localhost:3000"

# Google OAuth (optional) — enables Google Sign-In when both values are set
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <origin>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (optional) — enables Microsoft Sign-In when both values are set
# Create an app registration in Microsoft Entra ID
# Redirect URI: <origin>/api/v1/auth/microsoft/callback
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# Machine learning / face detection
# Set FACE_DETECTION_ENABLED=true to process faces via immich-machine-learning.
# With docker compose, use http://machine-learning:3003 (see docker-compose.yml).
# MACHINE_LEARNING_URL="http://localhost:3003"
# MACHINE_LEARNING_FACE_MODEL="buffalo_l"
# MACHINE_LEARNING_TIMEOUT_MS="30000"
# MACHINE_LEARNING_API_STYLE="predict" # "predict" or legacy "legacy"
# FACE_MATCH_THRESHOLD="0.5"
